function runSizeAdvicePrivateRev2_20261113() {
  const prefix='ADW_SIZE_PRIVATE_REV2_20261113_';
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1)){Logger.log('REV2 locked; no request');return;}
  try {
    const props=PropertiesService.getScriptProperties();
    if(props.getProperty(prefix+'HALTED')){Logger.log('REV2 halted; no request');return;}
    // Fail closed for unfamiliar existing records; never reset existing state.
    const existing=props.getProperties();
    const allowed=[prefix+'COUNT',prefix+'HALTED',...REV2_CASES.flatMap(c=>[prefix+'CASE_'+c.id,prefix+'RESULT_'+c.id])];
    if(Object.keys(existing).some(k=>k.startsWith(prefix)&&!allowed.includes(k))){Logger.log('REV2 existing record format requires review; no request');return;}
    const rawCount=props.getProperty(prefix+'COUNT');
    if(rawCount!==null&&!/^\d+$/.test(rawCount)){Logger.log('REV2 invalid counter; no request');return;}
    let count=Number(rawCount||0);
    const recorded=REV2_CASES.filter(c=>props.getProperty(prefix+'CASE_'+c.id)!==null).length;
    if(count<recorded){Logger.log('REV2 inconsistent counter; no request');return;}
    const key=props.getProperty('OPENAI_API_KEY'),model=props.getProperty('OPENAI_MODEL');
    if(!key||!model){Logger.log('REV2 missing configuration; no request');return;}
    for(const c of REV2_CASES) {
      if(props.getProperty(prefix+'CASE_'+c.id)!==null){Logger.log('REV2 case '+c.id+' already recorded; skipped');continue;}
      if(count>=4){Logger.log('REV2 limit reached; no request');return;}
      // Count first: a failure between writes consumes budget conservatively.
      props.setProperty(prefix+'COUNT',String(++count));
      props.setProperty(prefix+'CASE_'+c.id,'reserved_before_send');
      if(props.getProperty(prefix+'COUNT')!==String(count)||props.getProperty(prefix+'CASE_'+c.id)!=='reserved_before_send')return;
      const payload=JSON.parse(JSON.stringify(c.payload));payload.model=model;
      const start=Date.now();let response,body;
      try {response=UrlFetchApp.fetch('https://api.openai.com/v1/responses',{
        method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+key},
        payload:JSON.stringify(payload),muteHttpExceptions:true,followRedirects:false});}
      catch(ignored){props.setProperty(prefix+'HALTED','transport_or_GAS_error');Logger.log(JSON.stringify({case:c.id,error:'transport_or_GAS_error',ms:Date.now()-start}));return;}
      const http=response.getResponseCode(),ms=Date.now()-start;
      try {body=JSON.parse(response.getContentText());}
      catch(ignored){props.setProperty(prefix+'HALTED','non_json_response');Logger.log(JSON.stringify({case:c.id,http,ms,error:'non_json_response'}));return;}
      if(http<200||http>=300||body.error){
        const safe=v=>/^[a-z][a-z0-9_]{0,79}$/.test(String(v||''))?String(v):null;
        props.setProperty(prefix+'HALTED','api_error');
        Logger.log(JSON.stringify({case:c.id,http,ms,error_code:safe((body.error||{}).code),error_type:safe((body.error||{}).type)}));return;
      }
      const raw=(body.output||[]).flatMap(x=>x.content||[]).filter(x=>x.type==='output_text').map(x=>x.text).join('');
      let answer=null,validation='not_json';
      try {answer=JSON.parse(raw);REV2_validateAdvice(answer,c.product,c.profile);validation=body.status==='completed'?'pass':'incomplete';}
      catch(ignored){validation='invalid_advice';}
      const result={case:c.id,item:c.item,model,http,ms,response_status:body.status,usage:body.usage||null,answer,output_text:answer?null:raw,validation};
      // This is fictional test output, never headers/key/raw API error bodies.
      props.setProperty(prefix+'RESULT_'+c.id,JSON.stringify(result));
      props.setProperty(prefix+'CASE_'+c.id,'completed');
      Logger.log(JSON.stringify(result));
    }
  } finally {lock.releaseLock();}
